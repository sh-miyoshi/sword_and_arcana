{
  "format_version": "1.21.40",
  "minecraft:entity": {
    "description": {
      "identifier": "my:black_magic_sphere",
      "is_summonable": true,
      "is_spawnable": false,
      "properties": {
        "my:radius": {
          "type": "float",
          "range": [0.01, 16.0],
          "default": 0.5,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:collision_box": { "width": 0, "height": 0 },
      "minecraft:physics": { "has_gravity": false, "has_collision": false },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:damage_sensor": { "triggers": { "cause": "all", "deals_damage": "no" } },
      "minecraft:transient": {},
      "minecraft:timer": {
        "time": 10,
        "looping": false,
        "time_down_event": { "event": "my:expire", "target": "self" }
      }
    },
    "component_groups": {
      "my:expired": { "minecraft:instant_despawn": {} }
    },
    "events": {
      "my:expire": { "add": { "component_groups": ["my:expired"] } }
    }
  }
}
