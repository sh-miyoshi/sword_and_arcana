{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "my:fire_rod",
      "item": {
        "my:fire_rod": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/fire_rod_model",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.fire_rod"
      },
      "animations": {
        "hold_first_person": "animation.fire_rod.hold_first_person",
        "hold_third_person": "animation.fire_rod.hold_third_person"
      },
      "scripts": {
        "animate": [
          {
            "hold_first_person": "context.is_first_person == 1.0"
          },
          {
            "hold_third_person": "context.is_first_person == 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
